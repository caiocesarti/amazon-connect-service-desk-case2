    "flowName": "SD-Transbordo-N1",
    "flowDescription": "Preservação de contexto sd_*, verificação de horário comercial e roteamento inteligente por chave lógica para filas segmentadas."
  },
  "Actions": [
    {
      "Identifier": "bloco-gravar-contexto-transbordo",
      "Type": "UpdateContactAttributes",
      "Parameters": {
        "Attributes": {
          "sd_resumo": "$.Attributes.sd_resumo",
          "sd_motivo_transbordo": "$.Attributes.sd_motivo_transbordo",
          "sd_fila_destino": "$.Attributes.sd_fila_destino",
          "sd_prioridade": "$.Attributes.sd_prioridade",
          "sd_protocolo": "$.Attributes.sd_protocolo"
        }
      },
      "Transitions": {
        "NextAction": "bloco-definir-sussurro-agente",
        "Errors": [
          {
            "ErrorType": "NoMatchingError",
            "NextAction": "bloco-definir-sussurro-agente"
          }
        ]
      }
    },
    {
      "Identifier": "bloco-definir-sussurro-agente",
      "Type": "UpdateContactEventHooks",
      "Parameters": {
        "EventHooks": {
          "AgentWhisper": "arn:aws:connect:<REGION>:000000000000:instance/<INSTANCE_ID>/contact-flow/<FLOW_ID_SUSSURRO_AGENTE>"
        }
      },
      "Transitions": {
        "NextAction": "bloco-selecionar-fila-por-chave",
        "Errors": [
          {
            "ErrorType": "NoMatchingError",
            "NextAction": "bloco-selecionar-fila-por-chave"
          }
        ]
      }
    },
    {
      "Identifier": "bloco-selecionar-fila-por-chave",
      "Type": "Compare",
      "Parameters": {
        "ComparisonValue": "$.Attributes.sd_fila_destino"
      },
      "Transitions": {
        "NextAction": "bloco-fila-geral-n1",
        "Conditions": [
          {
            "NextAction": "bloco-fila-prioritaria-p1",
            "Condition": {
              "Operator": "Equals",
              "Operands": [
                "PRIORITARIA_P1"
              ]
            }
          },
          {
            "NextAction": "bloco-fila-seguranca",
            "Condition": {
              "Operator": "Equals",
              "Operands": [
                "SEGURANCA"
              ]
            }
          },
          {
            "NextAction": "bloco-fila-redes",
            "Condition": {
              "Operator": "Equals",
              "Operands": [
                "REDES"
              ]
            }
          },
          {
            "NextAction": "bloco-fila-hardware",
            "Condition": {
              "Operator": "Equals",
              "Operands": [
                "HARDWARE"
              ]
            }
          },
          {
            "NextAction": "bloco-fila-geral-n1",
            "Condition": {
              "Operator": "Equals",
              "Operands": [
                "GERAL_N1"
              ]
            }
          }
        ],
        "Errors": [
          {
            "ErrorType": "NoMatchingCondition",
            "NextAction": "bloco-fila-geral-n1"
          }
        ]
      }
    },
    {
      "Identifier": "bloco-fila-prioritaria-p1",
