# ============================================================================
# NuvemTech Service Desk - variáveis de ambiente (TEMPLATE)
# ----------------------------------------------------------------------------
# Copie para .env (ignorado pelo git) e preencha localmente.
# Este arquivo só pode conter PLACEHOLDERS: 000000000000, <ACCOUNT_ID>,
# <REGION>, <INSTANCE_ALIAS>, <WIDGET_ID>... O scanner Zero-Leak valida isso.
# ============================================================================

# --- Conta e região ----------------------------------------------------------
AWS_REGION=us-east-1
AWS_ACCOUNT_ID=000000000000
AWS_PROFILE=<AWS_PROFILE>

# --- Amazon Connect ------------------------------------------------------------
CONNECT_INSTANCE_ALIAS=<INSTANCE_ALIAS>
CONNECT_INSTANCE_ID=<INSTANCE_ID>
CONNECT_INSTANCE_ARN=arn:aws:connect:us-east-1:000000000000:instance/<INSTANCE_ID>

# --- Amazon Lex V2 -------------------------------------------------------------
LEX_BOT_NAME=SD-ServiceDesk-Bot
LEX_BOT_ID=<LEX_BOT_ID>
LEX_BOT_ALIAS_NAME=SD-Live
LEX_BOT_ALIAS_ID=<LEX_BOT_ALIAS_ID>
LEX_LOCALE_ID=pt_BR

# --- AWS Lambda ----------------------------------------------------------------
LAMBDA_FUNCTION_NAME=sd-fulfillment-servicedesk
LOG_LEVEL=INFO

# --- Amazon Connect Cases ------------------------------------------------------
CASES_DOMAIN_ID=<CASES_DOMAIN_ID>
CASES_TEMPLATE_ID=<CASES_TEMPLATE_ID>
# true = não chama a API (testes locais); false = cria casos de verdade
CASES_DRY_RUN=true

# --- Amazon Q in Connect / base de conhecimento ------------------------------
Q_ASSISTANT_ARN=arn:aws:wisdom:us-east-1:000000000000:assistant/<Q_ASSISTANT_ID>
KB_BUCKET=sd-kb-artigos-000000000000-us-east-1

# --- Widget e landing page (Vercel) -------------------------------------------
CONNECT_WIDGET_ID=<WIDGET_ID>
# Snippet completo do widget: defina SOMENTE na Vercel (Environment Variables)
# ou use landing/widget-snippet.local.html localmente.
CONNECT_WIDGET_SNIPPET=
# Camada FinOps: máximo de aberturas do widget por navegador
WIDGET_MAX_INTERACOES=5
VERCEL_TOKEN=<VERCEL_TOKEN>
